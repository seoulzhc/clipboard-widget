<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="剪贴板助手"
        Width="360" Height="470"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual"
        FontFamily="Microsoft YaHei UI"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <sys:String x:Key="MsgCopied">已复制到剪贴板</sys:String>
        <sys:String x:Key="MsgCopyFailed">复制失败，剪贴板被占用</sys:String>
        <sys:String x:Key="MsgFavorite">收藏</sys:String>
        <sys:String x:Key="MsgUnfavorite">取消收藏</sys:String>
        <sys:String x:Key="MsgPinned">已置顶，点击取消置顶</sys:String>
        <sys:String x:Key="MsgPin">点击置顶窗口</sys:String>
        <sys:String x:Key="MsgEmptyHistory">暂无复制记录</sys:String>
        <sys:String x:Key="MsgEmptyFavorite">点左侧 ☆ 收藏常用内容</sys:String>
        <sys:String x:Key="MsgEditTitle">编辑内容</sys:String>
        <sys:String x:Key="MsgEditTip">编辑这一条</sys:String>
        <sys:String x:Key="MsgDeleteTip">删除这一条</sys:String>
        <sys:String x:Key="MsgDeleted">已删除</sys:String>
        <sys:String x:Key="MsgSave">保存</sys:String>
        <sys:String x:Key="MsgCancel">取消</sys:String>
        <sys:String x:Key="MsgEditHint">Ctrl+Enter 保存 · Esc 取消</sys:String>
        <sys:String x:Key="MsgSaved">已保存修改</sys:String>
        <sys:String x:Key="MsgTrayTip">剪贴板助手</sys:String>
        <sys:String x:Key="MsgTrayOpen">打开面板</sys:String>
        <sys:String x:Key="MsgTrayExit">退出</sys:String>

        <Style x:Key="IconBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RowBtn" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#EDF1F7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6,6,6"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StarBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="FontFamily" Value="Segoe UI Symbol"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#EEF2F7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
    <Border x:Name="RootCard" CornerRadius="14" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="4" Direction="270" Opacity="0.18" Color="#0F172A"/>
        </Border.Effect>

        <Grid>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid x:Name="Header" Grid.Row="0" Margin="14,11,10,6" Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Top">
                        <TextBlock Text="剪贴板" FontSize="15" FontWeight="SemiBold" Foreground="#0F172A"/>
                        <TextBlock Text="复制记录 · 收藏" FontSize="10.5" Foreground="#94A3B8" Margin="0,1,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button x:Name="MinBtn" Style="{StaticResource IconBtn}" Content="−"
                                FontSize="13" Width="26" Height="26" ToolTip="收起到底部"/>
                        <Button x:Name="PinBtn" Style="{StaticResource IconBtn}" Content="📌"
                                FontSize="12" Width="28" Height="26" Margin="2,0,0,0" ToolTip="置顶开关"/>
                        <Button x:Name="CloseBtn" Style="{StaticResource IconBtn}" Content="✕"
                                FontSize="12" Width="28" Height="26" Margin="2,0,0,0" ToolTip="关闭"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="12,2,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="2,0,0,5">
                            <TextBlock Text="复制记录" FontSize="11.5" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center"/>
                            <Border Background="#E7EDF5" CornerRadius="6" Padding="5,0" Margin="5,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="HistoryCount" Text="0" FontSize="9.5" Foreground="#64748B"/>
                            </Border>
                        </StackPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="HistoryPanel" Margin="0,0,0,2"/>
                        </ScrollViewer>
                    </DockPanel>

                    <DockPanel Grid.Column="2">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="2,0,0,5">
                            <TextBlock Text="收藏" FontSize="11.5" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center"/>
                            <Border Background="#FEF3C7" CornerRadius="6" Padding="5,0" Margin="5,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="FavCount" Text="0" FontSize="9.5" Foreground="#B45309"/>
                            </Border>
                        </StackPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="FavPanel" Margin="0,0,0,2"/>
                        </ScrollViewer>
                    </DockPanel>
                </Grid>

                <TextBlock x:Name="FooterHint" Grid.Row="2"
                           Text="单击复制 · 双击编辑 · 拖动边角缩放"
                           FontSize="9.5" Foreground="#94A3B8" Margin="14,4,14,10"/>
            </Grid>

            <Border x:Name="ResizeTL" Tag="TL" Width="16" Height="16" Background="Transparent"
                    HorizontalAlignment="Left" VerticalAlignment="Top" Cursor="SizeNWSE" Panel.ZIndex="20"/>
            <Border x:Name="ResizeTR" Tag="TR" Width="16" Height="16" Background="Transparent"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="SizeNESW" Panel.ZIndex="20"/>
            <Border x:Name="ResizeBL" Tag="BL" Width="16" Height="16" Background="Transparent"
                    HorizontalAlignment="Left" VerticalAlignment="Bottom" Cursor="SizeNESW" Panel.ZIndex="20"/>
            <Border x:Name="ResizeBR" Tag="BR" Width="18" Height="18" Background="Transparent"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE" Panel.ZIndex="20"/>

            <TextBlock Text="◢" FontSize="11" Foreground="#C7D2E0"
                       HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,4,2"
                       IsHitTestVisible="False"/>
        </Grid>
    </Border>
    </Grid>
</Window>
